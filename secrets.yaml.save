apiVersion: v1
kind: Secret
metadata:
  name: airflow-secrets
  namespace: airflowsumo
type: Opaque
stringData:
  POSTGRES_USER: airflowuser
  POSTGRES_PASSWORD: <new-db-password>
  POSTGRES_DB: airflow
  AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg://airflowuser:<new-db-password>@postgres:5432/airflow
  AIRFLOW__CORE__FERNET_KEY: <fernet-key>
  AIRFLOW__API_AUTH__JWT_SECRET: <jwt-secret>
  ADMIN_USERNAME: admin
  ADMIN_PASSWORD: <new-admin-password>
